<?xml version="1.0" encoding="UTF-8"?>
<!--
  Intentionally empty. Maven looks for the closest .mvn directory above the project, which would
  otherwise be the one at the root of the codesign-tools repository: its git-versioning extension
  would then rewrite the version of the demo projects. Not needed in a copy of a demo.
-->
<extensions xmlns="http://maven.apache.org/EXTENSIONS/1.0.0"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://maven.apache.org/EXTENSIONS/1.0.0 https://maven.apache.org/xsd/core-extensions-1.0.0.xsd">
</extensions>
