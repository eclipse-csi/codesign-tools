<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    The simplest build integration: during `package`, the main jar of the project is signed in
    place. Later phases (install, deploy) then publish the signed jar.
  -->
  <groupId>org.eclipse.csi.demo</groupId>
  <artifactId>project-artifact</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <codesign-maven-plugin.version>0.11.0</codesign-maven-plugin.version>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.eclipse.csi</groupId>
        <artifactId>codesign-maven-plugin</artifactId>
        <version>${codesign-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>sign</id>
            <!-- codesign binds to package by default: <phase> is only needed to move it. -->
            <goals>
              <goal>codesign</goal>
            </goals>
            <configuration>
              <organizationId>${env.SIGNPATH_ORGANIZATION_ID}</organizationId>
              <projectId>${env.SIGNPATH_PROJECT_ID}</projectId>
              <signingPolicy>${env.SIGNPATH_SIGNING_POLICY}</signingPolicy>
              <!-- One file, sent as is. -->
              <artifactConfiguration>jar</artifactConfiguration>
              <!--
                The API token is the password of the <server> of settings.xml whose id is
                "codesign" (the default <serverId>). See settings.xml.
              -->
              <serverId>codesign</serverId>
              <!--
                Nothing else to select: signProjectArtifact=auto (the default) picks the main
                artifact of jar, war, ear, rar, ejb and maven-plugin projects. Without
                <outputDirectory>, the signed jar replaces the original.
              -->
              <failOnNoFilesFound>true</failOnNoFilesFound>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
