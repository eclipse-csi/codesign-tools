<?xml version="1.0" encoding="utf-8"?>
<!--
  A mix of jars and Windows binaries signed in one request, packed at the root of a zip file.
  min-matches="0" makes each kind optional, so the same configuration fits a request with only
  jars, only Windows binaries, or both.

  The optional parameters are only recorded on the signing request, to trace a signature back to
  its build. SignPath drops the parameters a request sends but this file does not declare.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="buildNumber" default-value="local" />
    <parameter name="gitCommit" default-value="unknown" />
  </parameters>
  <zip-file>
    <jar-file path="*.jar" min-matches="0" max-matches="unbounded">
      <jar-sign />
    </jar-file>
    <pe-file path="*.exe" min-matches="0" max-matches="unbounded">
      <authenticode-sign />
    </pe-file>
    <pe-file path="*.dll" min-matches="0" max-matches="unbounded">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
