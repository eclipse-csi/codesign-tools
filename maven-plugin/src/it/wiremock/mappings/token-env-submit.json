    "headers": {
      "Authorization": {
        "equalTo": "Bearer my-env-token"
      }
    }
  },
  "response": {
    "status": 201,
    "headers": {
      "Content-Type": "application/json; charset=utf-8",
      "Location": "{{request.baseUrl}}/Api/v1/token-env-org/SigningRequests/abc123"
    },
    "body": "{\"signingRequestId\":\"abc123\"}",
    "transformers": [
      "response-template"
    ]
  }
}
