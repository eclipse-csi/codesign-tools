<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.eclipse.csi</groupId>
  <artifactId>codesign-parent</artifactId>
  <version>0.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Eclipse CSI Codesign Tools</name>
  <description>Eclipse CSI Codesign tools include CLI, Maven Plugin, and API components.</description>
  <url>https://github.com/eclipse-csi/codesign-tools</url>

  <modules>
    <module>api</module>
    <module>maven-plugin</module>
    <module>cli</module>
  </modules>

  <licenses>
    <license>
      <name>Eclipse Public License 2.0</name>
      <url>https://www.eclipse.org/legal/epl-2.0/</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Eclipse CSI Project Contributors</name>
      <organization>Eclipse Foundation</organization>
      <organizationUrl>https://www.eclipse.org/</organizationUrl>
    </developer>
  </developers>

  <organization>
    <name>Eclipse Foundation</name>
    <url>https://www.eclipse.org/</url>
  </organization>

  <scm>
    <connection>scm:git:https://github.com/eclipse-csi/codesign-tools.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/eclipse-csi/codesign-tools.git</developerConnection>
    <url>https://github.com/eclipse-csi/codesign-tools</url>
    <tag>HEAD</tag>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>

    <!-- Set to the HEAD commit timestamp by the git versioning extension
         (.mvn/maven-git-versioning-extension.xml). This value is only the fallback used
         when the extension is disabled. -->
    <project.build.outputTimestamp>1980-01-01T00:00:02Z</project.build.outputTimestamp>

    <!-- The version the CLI prints for its version option (-V). The git versioning extension
         sets it to the release version on a vX.Y.Z tag, and to a traceable development version
         elsewhere, e.g. 0.8.5-dev18+g1a2b3c4 (18 commits after v0.8.4, at commit 1a2b3c4).
         This default is only used when the extension is disabled. -->
    <codesign.build.version>${project.version}</codesign.build.version>

    <sigstore.skip>true</sigstore.skip>

    <!-- SignPath signing policy of the codesign profile. The release workflow sets it to
         release-signing on release tags. -->
    <codesign.signingPolicy>test-signing</codesign.signingPolicy>

    <!-- Whether the release profile's Maven Central check rejects -SNAPSHOT versions. Since the
         version is derived from git tags, main always builds X.Y.Z-SNAPSHOT: dry runs of the
         release (release.yml mode=dry-run, the local dry run in CONTRIBUTING.md) pass
         -Dpomchecker.release=false to keep every other POM check. Real releases keep it true. -->
    <pomchecker.release>true</pomchecker.release>

    <maven.version>3.10.2</maven.version>
    <okhttp.version>5.5.1</okhttp.version>
    <picocli.version>4.7.7</picocli.version>
    <archunit.version>1.5.1</archunit.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.eclipse.csi</groupId>
        <artifactId>codesign-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.maven</groupId>
        <artifactId>maven-plugin-api</artifactId>
        <version>${maven.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.maven.plugin-tools</groupId>
        <artifactId>maven-plugin-annotations</artifactId>
        <version>3.16.0</version>
      </dependency>
      <dependency>
        <groupId>org.apache.maven</groupId>
        <artifactId>maven-core</artifactId>
        <version>${maven.version}</version>
      </dependency>
      <dependency>
        <groupId>com.squareup.okhttp3</groupId>
        <artifactId>okhttp-jvm</artifactId>
        <version>${okhttp.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.code.gson</groupId>
        <artifactId>gson</artifactId>
        <version>2.15.0</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>6.1.3</version>
      </dependency>
      <dependency>
        <groupId>com.squareup.okhttp3</groupId>
        <artifactId>mockwebserver3</artifactId>
        <version>${okhttp.version}</version>
      </dependency>
      <dependency>
        <groupId>org.jetbrains.kotlin</groupId>
        <artifactId>kotlin-stdlib</artifactId>
        <version>2.4.21</version>
      </dependency>
      <dependency>
        <groupId>info.picocli</groupId>
        <artifactId>picocli</artifactId>
        <version>${picocli.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.jimfs</groupId>
        <artifactId>jimfs</artifactId>
        <version>1.3.2</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>dev.sigstore</groupId>
          <artifactId>sigstore-maven-plugin</artifactId>
          <version>2.4.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.16.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>3.2.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>3.12.0</version>
          <executions>
            <execution>
              <id>attach-javadocs</id>
              <goals>
                <goal>jar</goal>
              </goals>
              <configuration>
                <attach>true</attach>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <version>3.4.0</version>
          <executions>
            <execution>
              <id>attach-sources</id>
              <goals>
                <goal>jar-no-fork</goal>
              </goals>
              <configuration>
                <attach>true</attach>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.6.1</version>
          <configuration>
            <!-- Late-bound so the JaCoCo agent set by prepare-agent is picked up. -->
            <argLine>@{argLine}</argLine>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-antrun-plugin</artifactId>
          <version>3.2.0</version>
        </plugin>
        <plugin>
          <groupId>org.jreleaser</groupId>
          <artifactId>jreleaser-maven-plugin</artifactId>
          <version>1.27.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-site-plugin</artifactId>
          <version>3.22.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-project-info-reports-plugin</artifactId>
          <version>3.9.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-plugin-report-plugin</artifactId>
          <version>3.16.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-plugin-plugin</artifactId>
          <version>3.16.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>3.7.0</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>build-helper-maven-plugin</artifactId>
          <version>3.8.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>3.11.0</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>3.7.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-invoker-plugin</artifactId>
          <version>3.10.1</version>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>0.8.16</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>3.6.2</version>
        </plugin>
        <plugin>
          <groupId>org.graalvm.buildtools</groupId>
          <artifactId>native-maven-plugin</artifactId>
          <version>1.1.19</version>
        </plugin>
        <plugin>
          <groupId>org.asciidoctor</groupId>
          <artifactId>asciidoctor-maven-plugin</artifactId>
          <version>3.2.0</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>flatten-maven-plugin</artifactId>
          <version>1.9.0</version>
        </plugin>
        <plugin>
          <!-- Signs this project's own jars (codesign profile). This must be a released version,
               never ${project.version}: Maven cannot run a plugin built by the same reactor.
               Dependabot bumps it after each release. -->
          <groupId>org.eclipse.csi</groupId>
          <artifactId>codesign-maven-plugin</artifactId>
          <version>0.10.1</version>
        </plugin>
        <plugin>
          <groupId>org.cyclonedx</groupId>
          <artifactId>cyclonedx-maven-plugin</artifactId>
          <version>2.9.3</version>
          <configuration>
            <projectType>library</projectType>
            <schemaVersion>1.6</schemaVersion>
            <includeBomSerialNumber>true</includeBomSerialNumber>
            <includeCompileScope>true</includeCompileScope>
            <includeProvidedScope>true</includeProvidedScope>
            <includeRuntimeScope>true</includeRuntimeScope>
            <includeTestScope>false</includeTestScope>
            <includeSystemScope>true</includeSystemScope>
            <outputFormat>json</outputFormat>
            <outputName>bom</outputName>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>dev.sigstore</groupId>
        <artifactId>sigstore-maven-plugin</artifactId>
        <configuration>
          <skip>${sigstore.skip}</skip>
        </configuration>
        <executions>
          <execution>
            <id>sign</id>
            <goals>
              <goal>sign</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <!-- Aggregate coverage report from all modules, merged at verify phase
             after all sub-module builds complete. -->
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <inherited>false</inherited>
        <executions>
          <execution>
            <id>report-aggregate</id>
            <phase>verify</phase>
            <goals>
              <goal>report-aggregate</goal>
            </goals>
            <configuration>
              <!-- Include both unit-test and integration-test exec files. -->
              <dataFileIncludes>
                <dataFileInclude>target/jacoco.exec</dataFileInclude>
                <dataFileInclude>target/jacoco-it.exec</dataFileInclude>
              </dataFileIncludes>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <dependencies>
          <dependency>
            <groupId>org.kordamp.maven</groupId>
            <artifactId>pomchecker-enforcer-rules</artifactId>
            <version>1.15.0</version>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <id>enforce-build-environment</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireMavenVersion>
                  <version>[3.10,)</version>
                </requireMavenVersion>
                <requireJavaVersion>
                  <version>[21,)</version>
                </requireJavaVersion>
                <dependencyConvergence />
                <requireReleaseDeps>
                  <message>SNAPSHOT dependencies are not allowed.</message>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>org.eclipse.csi:codesign-parent</exclude>
                    <exclude>org.eclipse.csi:codesign-api</exclude>
                  </excludes>
                </requireReleaseDeps>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.jreleaser</groupId>
        <artifactId>jreleaser-maven-plugin</artifactId>
        <inherited>false</inherited>
        <configuration>
          <jreleaser>
            <project>
              <description>${project.description}</description>
              <copyright>Copyright (c) 2026 Eclipse Foundation AISBL and others</copyright>
              <links>
                <homepage>${project.url}</homepage>
              </links>
            </project>
            <release>
              <github>
                <overwrite>false</overwrite>
                <!--
                  BODY is included so that re-running a failed release repairs its notes.
                  This is safe because the body is derived deterministically from CHANGELOG.md.
                -->
                <update>
                  <enabled>true</enabled>
                  <sections>
                    <section>ASSETS</section>
                    <section>BODY</section>
                  </sections>
                </update>
                <!--
                  The release body is rendered by .github/scripts/render-release-notes.py from
                  the curated CHANGELOG.md section plus git history, and published verbatim.
                  JReleaser's own commit-derived changelog is not used: it buried the
                  hand-written notes under a list of Dependabot bumps. No formatting options
                  belong here, because JReleaser applies none when <external> is set.
                -->
                <changelog>
                  <external>${project.basedir}/target/release-notes.md</external>
                </changelog>
                <issues>
                  <enabled>true</enabled>
                </issues>
              </github>
            </release>
            <signing>
              <active>RELEASE</active>
              <pgp>
                <!--
                  The release key is exported with gpg export-secret-subkeys: its primary key
                  is a stub without key material. MEMORY mode signs with the subkey since
                  JReleaser 1.24.0 (jreleaser/jreleaser#2086).
                -->
                <mode>MEMORY</mode>
                <armored>true</armored>
              </pgp>
            </signing>
            <catalog>
              <github>
                <active>RELEASE</active>
                <attestationName>{{projectName}}-{{projectVersion}}</attestationName>
                <artifacts>true</artifacts>
                <files>true</files>
                <deployables>true</deployables>
              </github>
            </catalog>
            <deploy>
              <maven>
                <mavenCentral>
                  <sonatype>
                    <active>RELEASE</active>
                    <url>https://central.sonatype.com/api/v1/publisher</url>
                    <namespace>org.eclipse.csi</namespace>
                    <applyMavenCentralRules>true</applyMavenCentralRules>
                    <!--
                      How long JReleaser waits for Central to validate the upload: 45 x 20s,
                      15 minutes. The release workflow runs it with the UPLOAD stage through
                      .github/scripts/publish-to-maven-central.py, which keeps following the
                      deployment after this wait, and publishes it. This bound only has to stay
                      well under the script's own timeout.
                    -->
                    <retryDelay>20</retryDelay>
                    <maxRetries>45</maxRetries>
                    <stagingRepositories>
                      <stagingRepository>api/target/staging-deploy</stagingRepository>
                      <stagingRepository>maven-plugin/target/staging-deploy</stagingRepository>
                      <stagingRepository>cli/target/staging-deploy</stagingRepository>
                    </stagingRepositories>
                  </sonatype>
                </mavenCentral>
                <nexus2>
                  <snapshot-deploy>
                    <active>SNAPSHOT</active>
                    <snapshotUrl>https://central.sonatype.com/repository/maven-snapshots/</snapshotUrl>
                    <applyMavenCentralRules>false</applyMavenCentralRules>
                    <snapshotSupported>true</snapshotSupported>
                    <closeRepository>false</closeRepository>
                    <releaseRepository>false</releaseRepository>
                    <stagingRepositories>
                      <stagingRepository>api/target/staging-deploy</stagingRepository>
                      <stagingRepository>maven-plugin/target/staging-deploy</stagingRepository>
                      <stagingRepository>cli/target/staging-deploy</stagingRepository>
                    </stagingRepositories>
                  </snapshot-deploy>
                </nexus2>
              </maven>
            </deploy>
            <distributions>
              <csi-codesign>
                <type>BINARY</type>
                <executable>
                  <name>csi-codesign</name>
                </executable>
                <artifacts>
                  <artifact>
                    <path>out/archives/csi-codesign-{{projectVersion}}-linux-x86_64.tar.gz</path>
                    <platform>linux-x86_64</platform>
                  </artifact>
                  <artifact>
                    <path>out/archives/csi-codesign-{{projectVersion}}-linux-aarch_64.tar.gz</path>
                    <platform>linux-aarch_64</platform>
                  </artifact>
                  <artifact>
                    <path>out/archives/csi-codesign-{{projectVersion}}-osx-aarch_64.tar.gz</path>
                    <platform>osx-aarch_64</platform>
                  </artifact>
                  <artifact>
                    <path>out/archives/csi-codesign-{{projectVersion}}-windows-x86_64.zip</path>
                    <platform>windows-x86_64</platform>
                  </artifact>
                </artifacts>
              </csi-codesign>
            </distributions>
            <!--
              The .sigstore.json bundles are written by the "Sign release assets with Sigstore"
              step of .github/workflows/release.yml. They are listed one by one, not globbed,
              so that a missing bundle fails the release instead of shipping unsigned assets.
            -->
            <files>
              <artifacts>
                <artifact>
                  <path>out/cli-fatjar/codesign-cli-{{projectVersion}}-bin.jar</path>
                </artifact>
                <artifact>
                  <path>out/cli-fatjar/codesign-cli-{{projectVersion}}-bin.jar.sigstore.json</path>
                </artifact>
                <artifact>
                  <path>out/archives/csi-codesign-{{projectVersion}}-linux-x86_64.tar.gz.sigstore.json</path>
                </artifact>
                <artifact>
                  <path>out/archives/csi-codesign-{{projectVersion}}-linux-aarch_64.tar.gz.sigstore.json</path>
                </artifact>
                <artifact>
                  <path>out/archives/csi-codesign-{{projectVersion}}-osx-aarch_64.tar.gz.sigstore.json</path>
                </artifact>
                <artifact>
                  <path>out/archives/csi-codesign-{{projectVersion}}-windows-x86_64.zip.sigstore.json</path>
                </artifact>
              </artifacts>
            </files>
          </jreleaser>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>generate-sbom</id>
      <build>
        <plugins>
          <!-- Aggregate BOM for the parent (all child modules combined).
               Not inherited — leaf modules use makeBom in their own profile. -->
          <plugin>
            <groupId>org.cyclonedx</groupId>
            <artifactId>cyclonedx-maven-plugin</artifactId>
            <inherited>false</inherited>
            <executions>
              <execution>
                <id>generate-project-sbom</id>
                <!-- prepare-package guarantees bom.json exists before the package
                     phase runs cdxgen and the cyclonedx merge. -->
                <phase>prepare-package</phase>
                <goals>
                  <goal>makeAggregateBom</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <!-- cdxgen (GitHub Actions SBOM) + cyclonedx merge run in every module.
               workingDirectory points at the repo root so cdxgen always finds
               .github/workflows/ regardless of which module is being built. -->
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>generate-github-actions-sbom</id>
                <phase>package</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                  <executable>cdxgen</executable>
                  <arguments>
                    <argument>-t</argument>
                    <argument>github</argument>
                    <argument>-o</argument>
                    <argument>${project.build.directory}/bom_gha.json</argument>
                    <argument>--json-pretty</argument>
                    <argument>.</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>merge-sbom</id>
                <phase>package</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <workingDirectory>${project.basedir}</workingDirectory>
                  <executable>cyclonedx</executable>
                  <arguments>
                    <argument>merge</argument>
                    <argument>--input-files</argument>
                    <argument>${project.build.directory}/bom.json</argument>
                    <argument>${project.build.directory}/bom_gha.json</argument>
                    <argument>--output-file</argument>
                    <argument>${project.build.directory}/bom_all.json</argument>
                    <argument>--output-format</argument>
                    <argument>json</argument>
                    <argument>--output-version</argument>
                    <argument>v1_6</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>attach-bom-all</id>
                <phase>package</phase>
                <goals>
                  <goal>attach-artifact</goal>
                </goals>
                <configuration>
                  <artifacts>
                    <artifact>
                      <file>${project.build.directory}/bom_all.json</file>
                      <type>json</type>
                      <classifier>bom-all</classifier>
                    </artifact>
                  </artifacts>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>release</id>
      <properties>
        <altDeploymentRepository>local::file:${project.build.directory}/staging-deploy</altDeploymentRepository>
      </properties>
      <build>
        <defaultGoal>deploy</defaultGoal>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <executions>
              <execution>
                <id>enforce-maven-central-requirements</id>
                <goals>
                  <goal>enforce</goal>
                </goals>
                <configuration>
                  <rules>
                    <checkMavenCentral implementation="org.kordamp.maven.enforcer.checker.CheckMavenCentral">
                      <release>${pomchecker.release}</release>
                    </checkMavenCentral>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>flatten-maven-plugin</artifactId>
            <configuration>
              <flattenMode>ossrh</flattenMode>
            </configuration>
            <executions>
              <execution>
                <id>flatten</id>
                <phase>process-resources</phase>
                <goals>
                  <goal>flatten</goal>
                </goals>
              </execution>
              <execution>
                <id>flatten-clean</id>
                <phase>clean</phase>
                <goals>
                  <goal>clean</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <!--
        Signs the jars with SignPath, through its GitHub connector: the Eclipse Foundation
        signing policies require trusted build system verification. Only works in a GitHub
        Actions job that sets CSI_CODESIGN_API_TOKEN, GITHUB_TOKEN, ACTIONS_RESULTS_URL and
        ACTIONS_RUNTIME_TOKEN (see the expose-actions-runtime action), and has the actions: read
        permission. The jars are signed in place at pre-integration-test: after jar and shade
        (package), before the Sigstore signatures (verify), deploy checksums, provenance
        attestations and OpenPGP signatures, so that all of these cover the signed jars.
        Each execution sends one jar as is, hence the jar-file artifact configuration.
      -->
      <id>codesign</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.eclipse.csi</groupId>
            <artifactId>codesign-maven-plugin</artifactId>
            <configuration>
              <organizationId>46624a66-6595-48fd-85c3-64bdee7fecc9</organizationId>
              <projectId>technology.csi</projectId>
              <signingPolicy>${codesign.signingPolicy}</signingPolicy>
              <artifactConfiguration>jar-file</artifactConfiguration>
              <submissionMode>github-actions</submissionMode>
            </configuration>
            <executions>
              <execution>
                <!-- The project artifact (signProjectArtifact=auto): skips the pom parent. -->
                <id>codesign</id>
                <phase>pre-integration-test</phase>
                <goals>
                  <goal>codesign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
